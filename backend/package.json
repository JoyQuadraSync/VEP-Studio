{
  "name": "vep-studio-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openai:smoke": "npm run build && node dist/scripts/openai-script-smoke.js",
    "test:openai:live": "npm run build && node --test tests-live/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "openai": "^7.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
